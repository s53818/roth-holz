---
import { Image, getImage } from 'astro:assets';
import { getGalleryPhotos } from '../lib/gallery';
import { gallerySection } from '../data/site';

// Die Komponente kennt keine Dateien, nur getGalleryPhotos().
const photos = await getGalleryPhotos();
const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: (await getImage({ src: p.src as any, width: 1800, format: 'webp', quality: 80 })).src,
  })),
);
---
<section id="galerie" class="section bg-lime" aria-labelledby="galerie-title">
  <div class="container">
    <p class="eyebrow on-lime">Eindrücke</p>
    <h2 id="galerie-title">{gallerySection.title}</h2>
    <p>{gallerySection.intro}</p>
    <ul class="grid">
      {items.map((p, i) => (
        <li>
          <a href={p.full} class="thumb" data-index={i} data-alt={p.alt} aria-label={`Bild vergrößern: ${p.alt}`}>
            <Image
              src={p.src as any}
              alt={p.alt}
              width={640}
              height={480}
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 33vw, 50vw"
              format="webp"
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <dialog id="lightbox" class="lightbox" aria-label="Bildansicht">
    <figure>
      <img id="lb-img" alt="" />
      <figcaption id="lb-cap"></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-act="close" aria-label="Schließen">×</button>
    <button type="button" class="lb-btn lb-prev" data-act="prev" aria-label="Vorheriges Bild">‹</button>
    <button type="button" class="lb-btn lb-next" data-act="next" aria-label="Nächstes Bild">›</button>
  </dialog>
</section>

<style>
  .grid { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }
  .thumb { display: block; overflow: hidden; border-radius: var(--radius); background: var(--c-olive); aspect-ratio: 4 / 3; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .thumb:hover :global(img) { transform: scale(1.05); }
  @media (prefers-reduced-motion: reduce) { .thumb:hover :global(img) { transform: none; } }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100%; height: 100%; color: #fff; }
  .lightbox::backdrop { background: rgb(20 21 17 / 0.92); }
  .lightbox figure { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3.5rem 1rem 1.5rem; gap: 0.75rem; }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 9rem); object-fit: contain; border-radius: var(--radius); }
  .lightbox figcaption { font-size: 0.95rem; color: var(--c-muted); text-align: center; }
  .lb-btn { position: absolute; width: 3rem; height: 3rem; border: 2px solid var(--c-lime); border-radius: 50%; background: var(--c-olive-deep); color: var(--c-lime); font-size: 1.8rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .lb-btn:hover { background: var(--c-lime); color: var(--c-on-lime); }
  .lb-close { top: 0.75rem; right: 0.75rem; }
  .lb-prev { left: 0.75rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 0.75rem; top: 50%; translate: 0 -50%; }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  const cap = document.getElementById('lb-cap');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#galerie .thumb'));
  if (dlg && img && cap && links.length && typeof dlg.showModal === 'function') {
    let current = 0;
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const a = links[current];
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      cap.textContent = `${a.dataset.alt ?? ''} (${current + 1}/${links.length})`;
    };
    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const act = t.closest<HTMLElement>('[data-act]')?.dataset.act;
      if (act === 'close' || t === dlg || t.tagName === 'FIGURE') dlg.close();
      else if (act === 'prev') show(current - 1);
      else if (act === 'next') show(current + 1);
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dlg.addEventListener('close', () => { img.removeAttribute('src'); links[current]?.focus(); });
  }
</script>
