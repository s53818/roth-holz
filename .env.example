# Beispiel-Umgebungsvariablen. Kopieren nach .env – nie .env committen.
# Aktuell wird keine davon benötigt; sie sind für spätere Ausbaustufen reserviert.

# --- Server (schon jetzt nutzbar: node ./dist/server/entry.mjs) ---
HOST=0.0.0.0
PORT=4321

# --- Mailversand (später, Nodemailer) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="ROTH Holz Service <office@holz-roth.at>"
# MAIL_TO=office@holz-roth.at

# --- Login (später, Better Auth) ---
# BETTER_AUTH_SECRET=mindestens-32-zeichen-langer-zufallswert
# BETTER_AUTH_URL=https://www.holz-roth.at

# --- Daten (später, SQLite/Drizzle und Galerie-Uploads) ---
# DATA_DIR=./data
